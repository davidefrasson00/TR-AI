# =====================================================================
# TR-AI — File di Configurazione delle Variabili d'Ambiente
# =====================================================================

# 1. Credenziali Bot Telegram
# Ottieni il token creando un bot con @BotFather su Telegram
TELEGRAM_BOT_TOKEN=

# Ottieni il tuo Chat ID personale scrivendo a @userinfobot su Telegram
TELEGRAM_CHAT_ID=

# 2. Modalità Operativa (DEFAULT: PAPER TRADING)
# Valori ammessi: PAPER (simulazione) | REAL (richiede conferma esplicita)
TR_AI_MODE=PAPER

# 3. Parametri Web Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
